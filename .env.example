# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nfl-live

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME="NFL Live Zone"

# Admin auth
ADMIN_EMAIL=admin@your-domain.com
# IMPORTANT: bcrypt hashes contain literal "$" characters, and Next.js expands
# "$NAME" in .env files as a variable reference. Escape every "$" as "\$" or
# the hash will be silently truncated. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# then replace each $ with \$ before pasting it below.
ADMIN_PASSWORD_HASH=\$2a\$10\$replace-with-your-escaped-bcrypt-hash
JWT_SECRET=replace-with-a-long-random-secret

# Default affiliate destination used when a game has no specific link set
DEFAULT_AFFILIATE_URL=https://your-affiliate-network.com/offer

# AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Web Push (kickoff reminders + pick results). Generate a key pair with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_CONTACT_EMAIL=mailto:you@your-domain.com
