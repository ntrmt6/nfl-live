# Apache reverse proxy to Next.js (Node.js on port 3000)
# Place this file at your Apache document root (e.g. /var/www/html/ or /public_html/)

Options -Indexes
ServerSignature Off

RewriteEngine On

# Serve static assets from Next.js .next/static directly if possible
# Otherwise proxy everything to the Node.js process

# Allow well-known files through
RewriteRule ^robots\.txt$ - [L]
RewriteRule ^sitemap\.xml$ - [L]
RewriteRule ^ads\.txt$ - [L]

# Proxy all other requests to Next.js
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L,QSA]

# Security headers (Apache level — also sent by Next.js headers config)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Block admin/api from being indexed at the Apache level too
    <FilesMatch "^(admin|api)">
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
